# Copy to .env. Defaults live in src/freezer_rag/config.py.
# Run project commands from the repository root.

# Change this model to switch embeddings; dimensions/collection default automatically.
RAG_EMBEDDING_MODEL=nomic-embed-text:v1.5

# Alternative: replace the active model above, then run ingest for that model.
# RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Advanced overrides are optional. Remove stale overrides when switching models.
# RAG_EMBEDDING_DIMENSIONS=768
# RAG_QDRANT_COLLECTION=freezer_docs_nomic_v1_5_768

# Model execution and generation settings for experiments.
RAG_EMBEDDING_BATCH_SIZE=4
RAG_LLM_NUM_CTX=4096
RAG_LLM_NUM_PREDICT=512
RAG_LLM_TEMPERATURE=0.1

# Chunking changes require rebuilding the index.
# Character counts are initial heuristics, not model token counts.
RAG_CHUNK_SIZE_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=200

# Retrieval settings can change without rebuilding the index.
RAG_DENSE_TOP_K=8
RAG_LEXICAL_TOP_K=8
RAG_FINAL_TOP_K=4
RAG_MAX_CONTEXT_CHARS=8000
