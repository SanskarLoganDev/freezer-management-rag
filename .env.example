# Copy to .env. Run project commands from the repository root.
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_LLM_MODEL=qwen3.5:4b
RAG_EMBEDDING_MODEL=nomic-embed-text:v1.5
RAG_EMBEDDING_DIMENSIONS=768
RAG_EMBEDDING_BATCH_SIZE=4
RAG_EMBEDDING_KEEP_ALIVE=0
RAG_LLM_KEEP_ALIVE=1m
RAG_LLM_NUM_CTX=4096
RAG_LLM_NUM_PREDICT=512
RAG_LLM_TEMPERATURE=0.1

RAG_DOCUMENTS_DIR=docs
RAG_PROCESSED_DIR=data/processed
RAG_MANIFESTS_DIR=data/manifests
RAG_QDRANT_PATH=data/indexes/qdrant
RAG_QDRANT_COLLECTION=freezer_docs_nomic_v1_5_768

# Character counts are initial heuristics, not model token counts.
RAG_CHUNK_SIZE_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=200
RAG_DENSE_TOP_K=8
RAG_LEXICAL_TOP_K=8
RAG_FINAL_TOP_K=4
RAG_MAX_CONTEXT_CHARS=8000
RAG_REQUEST_TIMEOUT_SECONDS=120
